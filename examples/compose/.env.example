# Settings for agents.yaml: copy to .env next to it and fill in the agents you
# run. Keep .env out of version control; it holds tokens.

# Azure Pipelines: a personal access token with Agent Pools (Read & manage).
AZP_URL=https://dev.azure.com/contoso
AZP_TOKEN=
AZP_POOL=Default

# GitHub Actions: a GitHub App installation token, or a fine-grained token with
# Administration write (repository) or Self-hosted runners write (organisation).
RUNNER_URL=https://github.com/contoso
RUNNER_ACCESS_TOKEN=
RUNNER_LABELS=containers

# GitLab: the authentication token (glrt-...) of a runner created in GitLab.
GITLAB_URL=https://gitlab.com
GITLAB_RUNNER_TOKEN=
