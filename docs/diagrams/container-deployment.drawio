<mxfile host="drawio" type="device"><diagram id="container-deployment" name="Container images: build, release and refresh flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1809" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Libre DevOps container images: build, release and refresh flow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="versions.yml is the single source of truth. Every change reaches the registries through a pull request that builds, tests and scans every image on amd64 and arm64, and a published image is rebuilt as soon as a fix exists. Only a change made by hand waits for a person." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;fontColor=#1a1a1a;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="40" as="geometry"/></mxCell>
