<mxCell id="k_ren" value="&lt;b&gt;Renovate&lt;/b&gt;&lt;br&gt;Bumps versions in versions.yml: weekly, and at once for a security fix" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_cur"><mxGeometry x="20" y="80" width="215" height="80" as="geometry"/></mxCell>
