<mxCell id="g_sig" value="&lt;b&gt;Signature, SBOM, provenance&lt;/b&gt;&lt;br&gt;cosign keyless signature, SBOM and SLSA provenance on every digest" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_reg"><mxGeometry x="25" y="1020" width="190" height="80" as="geometry"/></mxCell>
