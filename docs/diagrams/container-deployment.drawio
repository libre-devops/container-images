<mxCell id="p_test" value="&lt;b&gt;Smoke tests&lt;/b&gt;&lt;br&gt;Each image&amp;#x27;s suites, as uid 10001 and as any uid, and CA trust" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_pr"><mxGeometry x="30" y="340" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="p_test_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_pr"><mxGeometry x="40" y="358.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="p_scan" value="&lt;b&gt;Scan gate&lt;/b&gt;&lt;br&gt;Trivy: no critical, no fixable high; VEX for what does not apply" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_pr"><mxGeometry x="30" y="444" width="260" height="64" as="geometry"/></mxCell>
<mxCell id="p_scan_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_pr"><mxGeometry x="40" y="462.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="p_pass" value="&lt;b&gt;All pass?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontColor=#1a1a1a;" vertex="1" parent="ln_pr"><mxGeometry x="90" y="548" width="140" height="80" as="geometry"/></mxCell>
<mxCell id="p_info" value="&lt;b&gt;Also&lt;/b&gt;&lt;br&gt;Retry re-runs a job that failed on a network error, once. Portability builds and tests the latest images on RHEL, Wolfi and Alpine bases every two weeks, so changing the base stays a one-line edit." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_pr"><mxGeometry x="30" y="980" width="260" height="124" as="geometry"/></mxCell>
<mxCell id="p_info_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_pr"><mxGeometry x="40" y="1028.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="r_merge" value="&lt;b&gt;Merge to main&lt;/b&gt;&lt;br&gt;Bot pull requests merge themselves; others wait for review" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_main"><mxGeometry x="30" y="660" width="290" height="64" as="geometry"/></mxCell>
<mxCell id="r_merge_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_main"><mxGeometry x="40" y="678.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="r_rel" value="&lt;b&gt;Release workflow&lt;/b&gt;&lt;br&gt;On merge, every Monday, and when a published image can be fixed: builds every image again and pushes one digest to both registries, with version, date and moving tags" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_main"><mxGeometry x="30" y="780" width="290" height="96" as="geometry"/></mxCell>
<mxCell id="r_rel_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_main"><mxGeometry x="40" y="814.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="r_readme" value="&lt;b&gt;README digests&lt;/b&gt;&lt;br&gt;Recorded in README.md and releases.json by a pull request that merges itself" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_main"><mxGeometry x="30" y="930" width="290" height="64" as="geometry"/></mxCell>
<mxCell id="r_readme_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_main"><mxGeometry x="40" y="948.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="r_scan" value="&lt;b&gt;Scan workflow, daily&lt;/b&gt;&lt;br&gt;Every published image scanned again; findings in the Security tab; a fixable one starts Release" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_main"><mxGeometry x="30" y="1040" width="290" height="80" as="geometry"/></mxCell>
