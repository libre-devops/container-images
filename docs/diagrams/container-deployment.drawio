<mxCell id="p_pr" value="&lt;b&gt;Pull request&lt;/b&gt;&lt;br&gt;To versions.yml, the locks or the code, from a bot or a person" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_pr"><mxGeometry x="30" y="80" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="p_pr_icon" value="" style="image;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="ln_pr"><mxGeometry x="40" y="106.0" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="p_build" value="&lt;b&gt;Build&lt;/b&gt;&lt;br&gt;Every image and version from one Containerfile, built natively on amd64 and arm64" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_pr"><mxGeometry x="30" y="220" width="260" height="80" as="geometry"/></mxCell>
