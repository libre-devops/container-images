<mxCell id="k_pin" value="&lt;b&gt;Pins workflow, daily&lt;/b&gt;&lt;br&gt;Base digests, Terraform providers and Galaxy roles re-resolved; downloads repinned by SHA-256; vulnerable dependencies patched" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=44;" vertex="1" parent="ln_cur"><mxGeometry x="20" y="220" width="215" height="96" as="geometry"/></mxCell>
