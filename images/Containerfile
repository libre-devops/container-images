# Libre DevOps container images: one multi-stage build, one target per image.
#
#   docker build -f images/Containerfile --target <image> --build-arg ... .
#
# scripts/images.py computes every build argument from versions.yml and
# versions.lock.json, and `just build <image>` passes them for you. BASE_IMAGE
# can be any glibc base with a POSIX shell and apt-get, dnf, microdnf or apk;
# nothing below names a package manager or depends on the distribution.
#
# Stages (a target builds only the stages it needs):
#   fetch       Pinned release downloads, each checked against its SHA-256.
#   go          Go tools built from their pinned module source (verified by the
#               Go checksum database) with the pinned Go toolchain, after
#               raising every dependency with a known vulnerability to its fixed
#               version.
#   terraform-providers
#               The Terraform providers azure-terraform mirrors, each checked
#               against its pinned SHA-256.
#   openssh     The OpenSSH client, built from its latest release (see
#               images/common/build-openssh.sh for why), for the ansible images.
#   base        The base image, upgraded, with the shared packages, the app
#               user, the tools every image has, and a trust store that every
#               tool uses (add-ca-certificates adds an organisation's CA).
#   python, ansible, ansible-azure, azure-cli, terraform, powershell
#               The images, each on base.
#   toolbox     Everything, assembled from the stages above.
#   azure-terraform, azure-pipelines-agent, github-runner
#               On the stage named by ATOP: terraform for azure-terraform, and
#               base, or toolbox for their toolbox flavours, for the CI agents.

ARG BASE_IMAGE
ARG ATOP=base

FROM ${BASE_IMAGE} AS fetch
# A build stage only: nothing from it runs as root in an image.
# hadolint ignore=DL3002
USER 0
ARG SHELLCHECK_ASSET
ARG JQ_ASSET
ARG UV_ASSET=""
ARG LDO_CLI_ASSET=""
ARG POWERSHELL_ASSET=""
ARG AZURE_AZCOLLECTION_ASSET=""
ARG AZURE_PIPELINES_AGENT_ASSET=""
ARG GITHUB_RUNNER_ASSET=""
ARG TFSTACKS_ASSET=""
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/os-packages.sh ca-certificates curl tar gzip xz unzip \
    && sh /src/common/fetch-all.sh /fetched

FROM ${BASE_IMAGE} AS go
# hadolint ignore=DL3002
USER 0
ARG GO_ASSET
ARG SHFMT_GO
ARG TENV_GO=""
ARG TFLINT_GO=""
ARG TERRAFORM_DOCS_GO=""
ARG CONFTEST_GO=""
RUN --mount=type=bind,source=images,target=/src \
    --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    sh /src/common/os-packages.sh ca-certificates curl tar gzip git \
    && sh /src/common/fetch-tool.sh / go "${GO_ASSET}" \
    && sh /src/common/go-build-all.sh /built

FROM ${BASE_IMAGE} AS terraform-providers
# hadolint ignore=DL3002
USER 0
ARG TERRAFORM_PROVIDERS=""
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/os-packages.sh ca-certificates curl \
    && sh /src/terraform/fetch-providers.sh /mirror

FROM ${BASE_IMAGE} AS openssh
# hadolint ignore=DL3002
USER 0
ARG OPENSSH_ASSET=""
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/os-packages.sh ca-certificates curl tar gzip make gcc libc-dev 'linux-headers?' openssl-dev zlib-dev \
    && sh /src/common/fetch-tool.sh /fetched openssh "${OPENSSH_ASSET}" \
    && sh /src/common/build-openssh.sh /fetched/archive /built

FROM ${BASE_IMAGE} AS base
# hadolint ignore=DL3002
USER 0
ARG OS_PACKAGES=""
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/setup.sh
COPY --from=fetch /fetched/common/ /
COPY --from=go /built/shfmt/ /
# Every tool trusts the operating system's store, which setup.sh makes
# available at this one path on every base, so a CA added to it with
# add-ca-certificates is trusted everywhere: requests and pip (Python), uv,
# and Node (the CI agents run their tasks with it) included.
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    UV_NATIVE_TLS=true

FROM base AS python
ARG PYTHON_MINOR
COPY --from=fetch /fetched/uv/ /
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/ensure-python.sh "${PYTHON_MINOR}" /usr/local/bin/uv \
    && sh /src/common/finalise.sh
ENV HOME=/home/app \
    PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /work
CMD ["bash"]

FROM base AS ansible
ARG PYTHON_MINOR
ARG ANSIBLE_LOCK
COPY --from=fetch /fetched/uv/ /
COPY --from=openssh /built/ /
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/ensure-python.sh "${PYTHON_MINOR}" /usr/local/bin/uv \
    && sh /src/ansible/install.sh /usr/local/bin/uv "/src/${ANSIBLE_LOCK}" \
    && sh /src/common/finalise.sh
# ansible-core refuses to run unless the locale encoding is UTF-8.
ENV HOME=/home/app \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /work
CMD ["bash"]

FROM base AS ansible-azure
ARG PYTHON_MINOR
ARG ANSIBLE_LOCK
COPY --from=fetch /fetched/uv/ /
COPY --from=openssh /built/ /
RUN --mount=type=bind,source=images,target=/src \
    --mount=type=bind,from=fetch,source=/fetched,target=/fetched \
    sh /src/common/ensure-python.sh "${PYTHON_MINOR}" /usr/local/bin/uv \
    && sh /src/ansible/install.sh /usr/local/bin/uv "/src/${ANSIBLE_LOCK}" /fetched/azure-azcollection/collections \
    && sh /src/common/finalise.sh
ENV HOME=/home/app \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /work
CMD ["bash"]

FROM base AS azure-cli
ARG PYTHON_MINOR
ARG AZURE_CLI_LOCK
ARG LDO_CLI_LOCK
# uv builds the image but is not shipped in it.
RUN --mount=type=bind,source=images,target=/src \
    --mount=type=bind,from=fetch,source=/fetched,target=/fetched \
    sh /src/common/ensure-python.sh "${PYTHON_MINOR}" /fetched/uv/usr/local/bin/uv \
    && sh /src/azure-cli/install.sh /fetched/uv/usr/local/bin/uv \
        "/src/${AZURE_CLI_LOCK}" "/src/${LDO_CLI_LOCK}" /fetched/ldo-cli/wheels \
    && sh /src/common/finalise.sh
ENV HOME=/home/app \
    AZURE_CORE_COLLECT_TELEMETRY=no \
    PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /work
CMD ["bash"]

FROM base AS terraform
ARG TERRAFORM_VERSION
COPY --from=go /built/tenv/ /built/tflint/ /built/terraform-docs/ /built/conftest/ /
ENV TENV_ROOT=/home/app/.tenv \
    TENV_AUTO_INSTALL=true \
    CHECKPOINT_DISABLE=1
# tenv checks the HashiCorp signature and checksums of what it downloads.
RUN --mount=type=bind,source=images,target=/src \
    tenv tf install "${TERRAFORM_VERSION}" \
    && tenv tf use "${TERRAFORM_VERSION}" \
    && sh /src/common/finalise.sh
ENV HOME=/home/app
USER 10001:10001
WORKDIR /work
CMD ["bash"]

FROM base AS powershell
ARG AZ_POWERSHELL_VERSION
ARG MICROSOFT_GRAPH_VERSION
ARG PESTER_VERSION
ARG PSSCRIPTANALYZER_VERSION
ARG LIBREDEVOPSHELPERS_VERSION
COPY --from=fetch /fetched/powershell/ /
ENV POWERSHELL_TELEMETRY_OPTOUT=1 \
    POWERSHELL_UPDATECHECK=Off \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1
RUN --mount=type=bind,source=images,target=/src \
    sh /src/powershell/install-modules.sh \
    && sh /src/common/finalise.sh
ENV HOME=/home/app
USER 10001:10001
WORKDIR /work
CMD ["bash"]

FROM base AS toolbox
ARG PYTHON_MINOR
COPY --from=fetch /fetched/uv/ /
COPY --from=azure-cli /opt/ /opt/
COPY --from=azure-cli /usr/local/bin/az /usr/local/bin/ldo /usr/local/bin/
COPY --from=go /built/tenv/ /built/tflint/ /built/terraform-docs/ /built/conftest/ /
COPY --from=terraform /home/app/.tenv/ /home/app/.tenv/
COPY --from=powershell /opt/microsoft/ /opt/microsoft/
COPY --from=powershell /usr/local/share/powershell/ /usr/local/share/powershell/
ENV TENV_ROOT=/home/app/.tenv \
    TENV_AUTO_INSTALL=true \
    CHECKPOINT_DISABLE=1 \
    AZURE_CORE_COLLECT_TELEMETRY=no \
    POWERSHELL_TELEMETRY_OPTOUT=1 \
    POWERSHELL_UPDATECHECK=Off \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    PYTHONUNBUFFERED=1
RUN --mount=type=bind,source=images,target=/src \
    sh /src/common/ensure-python.sh "${PYTHON_MINOR}" /usr/local/bin/uv \
    && ln -sf /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh \
    && sh /src/common/finalise.sh
ENV HOME=/home/app
USER 10001:10001
WORKDIR /work
CMD ["bash"]

# A filesystem mirror of the pinned providers, and two Terraform CLI
# configurations: air-gapped (the default: the mirrored providers come only
# from the mirror, everything else from the registry) and registry.
FROM ${ATOP} AS azure-terraform
# hadolint ignore=DL3002
USER 0
COPY --from=terraform-providers /mirror/ /usr/local/share/terraform/providers/
COPY --from=fetch /fetched/tfstacks/ /
RUN --mount=type=bind,source=images,target=/src \
    sh /src/terraform/cli-configs.sh /usr/local/share/terraform \
    && sh /src/common/finalise.sh
ENV HOME=/home/app \
    TF_CLI_CONFIG_FILE=/usr/local/share/terraform/airgapped.tfrc
USER 10001:10001
WORKDIR /work
CMD ["bash"]

# The agents unpack into a directory they own, since they write their
# registration and their jobs' work there. Each starts with its start script,
# which registers it from environment variables.
FROM ${ATOP} AS azure-pipelines-agent
# Installs as root, then runs as the app user like every image.
# hadolint ignore=DL3002
USER 0
RUN --mount=type=bind,source=images,target=/src \
    --mount=type=bind,from=fetch,source=/fetched,target=/fetched \
    sh /src/agents/install.sh /fetched/azure-pipelines-agent/archive /opt/azure-pipelines-agent \
        /src/agents/azure-pipelines-agent.sh start-agent \
    && sh /src/common/finalise.sh
ENV HOME=/home/app
USER 10001:10001
WORKDIR /work
CMD ["start-agent"]

FROM ${ATOP} AS github-runner
# hadolint ignore=DL3002
USER 0
RUN --mount=type=bind,source=images,target=/src \
    --mount=type=bind,from=fetch,source=/fetched,target=/fetched \
    sh /src/agents/install.sh /fetched/github-runner/archive /opt/actions-runner \
        /src/agents/github-runner.sh start-runner \
    && sh /src/common/finalise.sh
ENV HOME=/home/app
USER 10001:10001
WORKDIR /work
CMD ["start-runner"]
